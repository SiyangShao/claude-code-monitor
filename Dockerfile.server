FROM node:22-slim

WORKDIR /app

# Copy workspace root
COPY package.json ./
COPY shared/package.json ./shared/
COPY server/package.json ./server/

# Install dependencies
RUN npm install

# Copy source
COPY tsconfig.json ./
COPY shared/ ./shared/
COPY server/ ./server/

# Build
RUN cd shared && npx tsc && cd ../server && npx tsc

# Data directory
RUN mkdir -p /data

ENV CLAUDE_MONITOR_CONFIG=/config/server-config.json
ENV CLAUDE_MONITOR_DB=/data/server.db

EXPOSE 19876

CMD ["node", "server/dist/index.js"]
